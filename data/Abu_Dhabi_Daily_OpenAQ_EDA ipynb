        "print(\"Rows retained for five pollutants:\", len(daily))\n",
        "print(\"Date range:\", daily[\"day\"].min().date(), \"to\", daily[\"day\"].max().date())\n",
        "print(\"Stations:\", daily[\"station_id\"].nunique())"
      ]
