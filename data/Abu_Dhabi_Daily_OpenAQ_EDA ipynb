        "    valid_station[p] = valid_station[p].where(master[f\"{p}_readings\"].ge(MIN_READINGS))\n",
        "station_medians = valid_station.groupby([\"station_id\", \"station\"])[POLLUTANTS].median()\n",
        "station_counts = valid_station.groupby([\"station_id\", \"station\"])[POLLUTANTS].count()\n",
        "\n",
        "# Standardize columns only for the visualization, not for export/model input.\n",
        "station_z = (station_medians - station_medians.mean()) / station_medians.std(ddof=0)\n",
        "fig, ax = plt.subplots(figsize=(7.4, 6.0))\n",
        "mat = station_z.to_numpy(dtype=float)\n",
        "im = ax.imshow(mat, aspect=\"auto\", cmap=\"RdBu_r\", norm=TwoSlopeNorm(vmin=-2.5, vcenter=0, vmax=2.5))\n",
        "ax.set_xticks(range(len(POLLUTANTS)), POLLUTANTS)\n",
        "ax.set_yticks(range(len(station_z.index)), [str(idx[1]).split(\"-\")[0] for idx in station_z.index], fontsize=7)\n",
        "ax.set_title(\"Station profiles: relative median pollutant levels\\n(z-score within each pollutant; 12+ readings)\")\n",
        "fig.colorbar(im, ax=ax, shrink=.75, label=\"Within-pollutant station z-score\")\n",
        "fig.savefig(FIGURES_DIR / \"07_station_pollutant_profile_heatmap.png\", bbox_inches=\"tight\")\n",
        "plt.show()\n",
        "\n",
        "display(station_medians.round(2))\n",
        "display(station_counts.rename(columns={p: f\"{p}_n\" for p in POLLUTANTS}))"
      ]
    },
