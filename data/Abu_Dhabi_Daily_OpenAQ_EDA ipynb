        "station_corr_rows = []\n",
        "for (sid, sname), g in master.groupby([\"station_id\", \"station\"]):\n",
        "    gv = g[[\"day\"] + POLLUTANTS].copy()\n",
        "    for p in POLLUTANTS:\n",
        "        gv[p] = gv[p].where(g[f\"{p}_readings\"].ge(MIN_READINGS))\n",
        "    for a, b in combinations(POLLUTANTS, 2):\n",
        "        pair = gv[[a, b]].dropna()\n",
        "        if len(pair) >= MIN_PAIR_DAYS:\n",
        "            station_corr_rows.append({\n",
        "                \"station_id\": sid, \"station\": sname, \"pollutant_1\": a,\n",
        "                \"pollutant_2\": b, \"n_pair_days\": len(pair),\n",
        "                \"spearman_rho\": pair[a].corr(pair[b], method=\"spearman\")\n",
        "            })\n",
        "station_correlations = pd.DataFrame(station_corr_rows)\n",
        "\n",
        "if len(station_correlations):\n",
        "    pair_labels = [f\"{a}–{b}\" for a, b in combinations(POLLUTANTS, 2)]\n",
        "    box_data = [station_correlations.loc[\n",
        "        (station_correlations.pollutant_1 == a) & (station_correlations.pollutant_2 == b),\n",
        "        \"spearman_rho\"].dropna().values for a, b in combinations(POLLUTANTS, 2)]\n",
        "    fig, ax = plt.subplots(figsize=(10, 4.2))\n",
        "    ax.boxplot(box_data, tick_labels=pair_labels, showfliers=False, patch_artist=True,\n",
        "               boxprops=dict(facecolor=\"#9DB9D2\", alpha=.8), medianprops=dict(color=\"#9B3C32\", linewidth=1.5))\n",
        "    ax.axhline(0, color=\"black\", lw=.8, alpha=.5)\n",
        "    ax.set_ylabel(\"Station-level Spearman rho\")\n",
        "    ax.set_title(\"How pollutant associations vary between stations\")\n",
        "    ax.tick_params(axis=\"x\", rotation=35)\n",
        "    ax.grid(axis=\"y\", alpha=.2)\n",
        "    fig.savefig(FIGURES_DIR / \"05_station_correlation_variation.png\", bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "else:\n",
        "    print(\"No station-level pairs met the minimum overlap threshold.\")\n",
        "\n",
        "display(station_correlations.head(20))"
