      "source": [
        "# Primary descriptive distribution uses observations with at least 12 readings.\n",
        "valid_values = master[POLLUTANTS].copy()\n",
        "for p in POLLUTANTS:\n",
        "    valid_values[p] = valid_values[p].where(master[f\"{p}_readings\"].ge(MIN_READINGS))\n",
        "\n",
        "summary_rows = []\n",
        "for p in POLLUTANTS:\n",
        "    s = valid_values[p].dropna()\n",
        "    summary_rows.append({\n",
        "        \"pollutant\": p, \"n_valid_12plus\": len(s), \"median\": s.median(),\n",
        "        \"mean\": s.mean(), \"q25\": s.quantile(.25), \"q75\": s.quantile(.75),\n",
        "        \"q95\": s.quantile(.95), \"maximum\": s.max(), \"skewness\": s.skew()\n",
        "    })\n",
        "descriptive_stats = pd.DataFrame(summary_rows)\n",
        "display(descriptive_stats.round(3))\n",
        "\n",
        "fig, axes = plt.subplots(2, 3, figsize=(10, 5.7))\n",
        "axes = axes.ravel()\n",
        "for ax, p in zip(axes, POLLUTANTS):\n",
        "    s = valid_values[p].dropna()\n",
        "    q99 = s.quantile(.99)\n",
        "    visible = s[s <= q99]\n",
        "    tail_n = int((s > q99).sum())\n",
        "    ax.hist(visible, bins=26, color=\"#4472A8\", alpha=.82, edgecolor=\"white\", linewidth=.4)\n",
        "    ax.axvline(s.median(), color=\"#D04A3A\", lw=1.5, label=f\"Median {s.median():.1f}\")\n",
        "    ax.axvline(s.quantile(.95), color=\"#E19A35\", lw=1.4, ls=\"--\", label=f\"95th pct {s.quantile(.95):.1f}\")\n",
        "    ax.set_xlim(left=0, right=q99 * 1.05 if q99 > 0 else None)\n",
        "    ax.set_title(f\"{p} (n={len(s):,}; {tail_n} above 99th pct)\")\n",
        "    ax.set_xlabel(\"Daily mean (source unit not stated)\")\n",
        "    ax.set_ylabel(\"Station-days\")\n",
        "    ax.grid(axis=\"y\", alpha=.18)\n",
        "    ax.legend(frameon=False, fontsize=7)\n",
        "axes[-1].axis(\"off\")\n",
        "fig.suptitle(\"Distributions of daily pollutant means (12+ readings)\", fontsize=12, fontweight=\"bold\")\n",
        "fig.savefig(FIGURES_DIR / \"03_pollutant_distributions.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
