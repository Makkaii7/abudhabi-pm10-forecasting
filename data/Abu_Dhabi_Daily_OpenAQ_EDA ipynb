      "source": [
        "INDEX_COLS = [\"station_id\", \"station\", \"station_metadata_name\", \"day\", \"lat\", \"lon\"]\n",
        "\n",
        "def pivot_parameter(value_col, suffix=None):\n",
        "    wide = daily.pivot(index=INDEX_COLS, columns=\"parameter\", values=value_col)\n",
        "    wide = wide.reindex(columns=POLLUTANTS)\n",
        "    if suffix:\n",
        "        wide.columns = [f\"{p}_{suffix}\" for p in wide.columns]\n",
        "    wide.columns.name = None\n",
        "    return wide\n",
        "\n",
        "mean_wide = pivot_parameter(\"mean\")\n",
        "max_wide = pivot_parameter(\"max\", \"max\")\n",
        "readings_wide = pivot_parameter(\"readings\", \"readings\")\n",
        "low_wide = pivot_parameter(\"flag_low_readings\", \"low_support_flag\")\n",
        "negative_wide = pivot_parameter(\"flag_negative_mean\", \"negative_mean_flag\")\n",
        "\n",
        "master = mean_wide.join([max_wide, readings_wide, low_wide, negative_wide]).reset_index()\n",
        "master = master.sort_values([\"station_id\", \"day\"]).reset_index(drop=True)\n",
        "\n",
        "# Calendar descriptors are derived solely from the observation date.\n",
        "master[\"year\"] = master[\"day\"].dt.year\n",
        "master[\"month\"] = master[\"day\"].dt.month\n",
        "master[\"day_of_month\"] = master[\"day\"].dt.day\n",
        "master[\"day_of_week\"] = master[\"day\"].dt.dayofweek\n",
        "master[\"day_of_year\"] = master[\"day\"].dt.dayofyear\n",
        "master[\"is_weekend\"] = master[\"day_of_week\"].isin([5, 6])\n",
        "master[\"month_sin\"] = np.sin(2 * np.pi * master[\"month\"] / 12)\n",
        "master[\"month_cos\"] = np.cos(2 * np.pi * master[\"month\"] / 12)\n",
        "master[\"day_of_year_sin\"] = np.sin(2 * np.pi * master[\"day_of_year\"] / 365.25)\n",
        "master[\"day_of_year_cos\"] = np.cos(2 * np.pi * master[\"day_of_year\"] / 365.25)\n",
        "\n",
        "master[\"n_pollutants_available\"] = master[POLLUTANTS].notna().sum(axis=1)\n",
        "low_cols = [f\"{p}_low_support_flag\" for p in POLLUTANTS]\n",
        "low_flags_bool = master[low_cols].astype(\"boolean\").fillna(False).astype(bool)\n",
        "master[\"n_pollutants_low_support\"] = low_flags_bool.sum(axis=1)\n",
        "master[\"all_five_pollutants_available\"] = master[POLLUTANTS].notna().all(axis=1)\n",
        "master[\"any_low_support_flag\"] = low_flags_bool.any(axis=1)\n",
        "\n",
        "print(\"Master shape:\", master.shape)\n",
        "print(\"Station-day rows:\", len(master))\n",
        "print(\"Stations:\", master[\"station_id\"].nunique())\n",
        "print(\"Distinct dates:\", master[\"day\"].nunique())\n",
        "print(\"All-five complete station-days:\", int(master[\"all_five_pollutants_available\"].sum()))\n",
        "display(master.head())"
      ]
    },
