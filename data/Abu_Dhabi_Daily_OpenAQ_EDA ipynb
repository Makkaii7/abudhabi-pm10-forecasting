        "coverage_rows = []\n",
        "for p in POLLUTANTS:\n",
        "    available = master[p].notna()\n",
        "    support = master[f\"{p}_readings\"].ge(MIN_READINGS)\n",
        "    coverage_rows.append({\n",
        "        \"pollutant\": p,\n",
        "        \"available_station_days\": int(available.sum()),\n",
        "        \"stations_reporting\": int(master.loc[available, \"station_id\"].nunique()),\n",
        "        \"available_share_of_master_rows_pct\": 100 * available.mean(),\n",
        "        \"station_days_with_12plus_readings\": int((available & support).sum()),\n",
        "        \"share_of_available_records_12plus_pct\": 100 * support[available].mean() if available.sum() else np.nan,\n",
        "    })\n",
        "pollutant_coverage = pd.DataFrame(coverage_rows)\n",
        "display(pollutant_coverage.round(2))\n",
        "\n",
        "station_coverage = master.groupby([\"station_id\", \"station\"])[POLLUTANTS].agg(lambda s: s.notna().sum()).reset_index()\n",
        "display(station_coverage.head(20))\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(10, 3.5))\n",
        "axes[0].bar(pollutant_coverage[\"pollutant\"], pollutant_coverage[\"available_station_days\"], color=\"#4472A8\")\n",
        "axes[0].set_title(\"Available station-days by pollutant\")\n",
        "axes[0].set_ylabel(\"Station-days\")\n",
        "axes[0].grid(axis=\"y\", alpha=.2)\n",
        "axes[1].bar(pollutant_coverage[\"pollutant\"], pollutant_coverage[\"share_of_available_records_12plus_pct\"], color=\"#4C9A79\")\n",
        "axes[1].set_title(\"Records with at least 12 readings\")\n",
        "axes[1].set_ylabel(\"% of available records\")\n",
        "axes[1].set_ylim(0, 105)\n",
        "axes[1].grid(axis=\"y\", alpha=.2)\n",
        "fig.suptitle(\"Measurement coverage and support\", fontsize=12, fontweight=\"bold\")\n",
        "fig.savefig(FIGURES_DIR / \"01_coverage_and_support.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
