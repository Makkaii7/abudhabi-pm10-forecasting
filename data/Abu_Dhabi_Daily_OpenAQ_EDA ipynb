      "source": [
        "station_cols = [\"station_id\", \"station\", \"lat\", \"lon\"]\n",
        "stations = stations[station_cols].drop_duplicates().copy()\n",
        "\n",
        "station_key_duplicates = stations[stations.duplicated(\"station_id\", keep=False)]\n",
        "if len(station_key_duplicates):\n",
        "    display(station_key_duplicates.sort_values(\"station_id\"))\n",
        "    raise ValueError(\"Station metadata has multiple records per station_id. Resolve before merging.\")\n",
        "\n",
        "station_lookup = stations.rename(columns={\"station\": \"station_metadata_name\"})\n",
        "daily = daily.merge(\n",
        "    station_lookup[[\"station_id\", \"station_metadata_name\", \"lat\", \"lon\"]],\n",
        "    on=\"station_id\", how=\"left\", validate=\"many_to_one\"\n",
        ")\n",
        "\n",
        "unmatched_ids = sorted(daily.loc[daily[\"lat\"].isna() | daily[\"lon\"].isna(), \"station_id\"].unique().tolist())\n",
        "print(\"Daily-data stations:\", daily[\"station_id\"].nunique())\n",
        "print(\"Metadata stations:\", stations[\"station_id\"].nunique())\n",
        "print(\"Station IDs without coordinates:\", unmatched_ids)\n",
        "print(\"Coordinate-complete source rows:\", daily[[\"lat\", \"lon\"]].notna().all(axis=1).sum(), \"/\", len(daily))"
      ]
