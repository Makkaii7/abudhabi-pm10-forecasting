      "source": [
        "\n",
        "# ============================================================\n",
        "# STEP 17 — STATION-RELATIVE ANOMALIES\n",
        "# Distinguish individual upper-tail observations from\n",
        "# multi-station co-occurrence and insufficient coverage.\n",
        "# ============================================================\n",
        "\n",
        "anomaly_records = []\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Calculate station-specific 95th-percentile thresholds\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "for (sid, sname), g in master.groupby(\n",
        "    [\"station_id\", \"station\"]\n",
        "):\n",
        "\n",
        "    for p in POLLUTANTS:\n",
        "\n",
        "        supported = (\n",
        "            g[p].notna()\n",
        "            & g[f\"{p}_readings\"].ge(MIN_READINGS)\n",
        "        )\n",
        "\n",
        "        vals = g.loc[supported, p]\n",
        "\n",
        "        # Require enough observations to estimate a threshold\n",
        "        if len(vals) < 30:\n",
        "            continue\n",
        "\n",
        "        q95 = vals.quantile(STATION_UPPER_QUANTILE)\n",
        "\n",
        "        flagged = supported & g[p].gt(q95)\n",
        "\n",
        "        for _, r in g.loc[\n",
        "            flagged, [\"day\", p, f\"{p}_readings\"]\n",
        "        ].iterrows():\n",
        "\n",
        "            anomaly_records.append({\n",
        "                \"station_id\": sid,\n",
        "                \"station\": sname,\n",
        "                \"day\": r[\"day\"],\n",
        "                \"pollutant\": p,\n",
        "                \"value\": r[p],\n",
        "                \"readings\": r[f\"{p}_readings\"],\n",
        "                \"station_q95\": q95,\n",
        "                \"flag_type\": \"station_relative_upper_tail\"\n",
        "            })\n",
        "\n",
        "station_anomalies = pd.DataFrame(\n",
        "    anomaly_records,\n",
        "    columns=[\n",
        "        \"station_id\", \"station\", \"day\", \"pollutant\",\n",
        "        \"value\", \"readings\", \"station_q95\", \"flag_type\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Station-relative upper-tail observations:\",\n",
        "    len(station_anomalies)\n",
        ")\n",
        "\n",
        "display(station_anomalies.head(20))\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Examine upper-tail observations across stations\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "event_rows = []\n",
        "\n",
        "for p in POLLUTANTS:\n",
        "\n",
        "    reporter = master[\n",
        "        master[p].notna()\n",
        "        & master[f\"{p}_readings\"].ge(MIN_READINGS)\n",
        "    ].copy()\n",
        "\n",
        "    # Station-specific thresholds\n",
        "    q95_map = reporter.groupby(\"station_id\")[p].quantile(\n",
        "        STATION_UPPER_QUANTILE\n",
        "    )\n",
        "\n",
        "    reporter[\"station_q95\"] = reporter[\"station_id\"].map(q95_map)\n",
        "\n",
        "    reporter[\"upper_tail_flag\"] = (\n",
        "        reporter[p] > reporter[\"station_q95\"]\n",
        "    )\n",
        "\n",
        "    for day, g in reporter.groupby(\"day\"):\n",
        "\n",
        "        n_reporting = g[\"station_id\"].nunique()\n",
        "\n",
        "        n_flagged = g.loc[\n",
        "            g[\"upper_tail_flag\"], \"station_id\"\n",
        "        ].nunique()\n",
        "\n",
        "        if n_flagged == 0:\n",
        "            continue\n",
        "\n",
        "        flagged_share = (\n",
        "            n_flagged / n_reporting\n",
        "            if n_reporting else np.nan\n",
        "        )\n",
        "\n",
        "        # Sensitivity analysis using three different thresholds\n",
        "        for cutoff in [0.20, 0.25, 0.33]:\n",
        "\n",
        "            if n_reporting < MIN_REPORTING_STATIONS:\n",
        "\n",
        "                classification = \"insufficient_reporting_coverage\"\n",
        "\n",
        "            elif n_flagged == 1:\n",
        "\n",
        "                classification = \"single_station_upper_tail\"\n",
        "\n",
        "            elif flagged_share >= cutoff:\n",
        "\n",
        "                classification = \"multi_station_cooccurrence\"\n",
        "\n",
        "            else:\n",
        "\n",
        "                classification = \"multiple_flags_below_cutoff\"\n",
        "\n",
        "            event_rows.append({\n",
        "                \"pollutant\": p,\n",
        "                \"day\": day,\n",
        "                \"reporting_stations\": n_reporting,\n",
        "                \"flagged_stations\": n_flagged,\n",
        "                \"flagged_share\": flagged_share,\n",
        "                \"share_cutoff\": cutoff,\n",
        "                \"classification\": classification\n",
        "            })\n",
        "\n",
        "event_sensitivity = pd.DataFrame(\n",
        "    event_rows,\n",
        "    columns=[\n",
        "        \"pollutant\", \"day\", \"reporting_stations\",\n",
        "        \"flagged_stations\", \"flagged_share\",\n",
        "        \"share_cutoff\", \"classification\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Summarize the main 25% screening rule\n",
        "# ------------------------------------------------------------\n",
        "\n",
        "if len(event_sensitivity):\n",
        "\n",
        "    event_25 = event_sensitivity[\n",
        "        event_sensitivity[\"share_cutoff\"].eq(0.25)\n",
        "    ]\n",
        "\n",
        "    event_summary = (\n",
        "        event_25.groupby(\n",
        "            [\"pollutant\", \"classification\"]\n",
        "        )\n",
        "        .size()\n",
        "        .unstack(fill_value=0)\n",
        "        .reindex(POLLUTANTS)\n",
        "        .fillna(0)\n",
        "        .astype(int)\n",
        "    )\n",
        "\n",
        "    display(event_summary)\n",
        "\n",
        "    print(\"Sensitivity of multi-station co-occurrence counts:\")\n",
        "\n",
        "    display(\n",
        "        event_sensitivity[\n",
        "            event_sensitivity[\"classification\"]\n",
        "            == \"multi_station_cooccurrence\"\n",
        "        ]\n",
        "        .groupby([\"pollutant\", \"share_cutoff\"])\n",
        "        .size()\n",
        "        .unstack(fill_value=0)\n",
        "    )\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # 4. Compact visualization\n",
        "    # --------------------------------------------------------\n",
        "\n",
        "    event_plot = (\n",
        "        event_25.groupby(\n",
        "            [\"pollutant\", \"classification\"]\n",
        "        )\n",
        "        .size()\n",
        "        .unstack(fill_value=0)\n",
        "        .reindex(POLLUTANTS)\n",
        "        .fillna(0)\n",
        "    )\n",
        "\n",
        "    category_order = [\n",
        "        \"single_station_upper_tail\",\n",
        "        \"multiple_flags_below_cutoff\",\n",
        "        \"multi_station_cooccurrence\",\n",
        "        \"insufficient_reporting_coverage\"\n",
        "    ]\n",
        "\n",
        "    event_plot = event_plot.reindex(\n",
        "        columns=category_order,\n",
        "        fill_value=0\n",
        "    )\n",
        "\n",
        "    colors = [\n",
        "        \"#D69A36\",\n",
        "        \"#A7A7A7\",\n",
        "        \"#4C9A79\",\n",
        "        \"#C65B55\"\n",
        "    ]\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(8, 4))\n",
        "\n",
        "    event_plot.plot(\n",
        "        kind=\"bar\",\n",
        "        stacked=True,\n",
        "        ax=ax,\n",
        "        color=colors\n",
        "    )\n",
        "\n",
        "    ax.set_ylabel(\"Pollutant-days with at least one upper-tail flag\")\n",
        "    ax.set_xlabel(\"Pollutant\")\n",
        "\n",
        "    ax.set_title(\n",
        "        \"Upper-tail observations: spatial co-occurrence screening\\n\"\n",
        "        \"(25% of reporting stations; minimum coverage applied)\"\n",
        "    )\n",
        "\n",
        "    ax.legend(\n",
        "        title=\"Classification\",\n",
        "        frameon=False,\n",
        "        fontsize=7\n",
        "    )\n",
        "\n",
        "    ax.tick_params(axis=\"x\", rotation=0)\n",
        "    ax.grid(axis=\"y\", alpha=0.2)\n",
        "\n",
        "    fig.savefig(\n",
        "        FIGURES_DIR / \"10_local_vs_multistation_screening.png\",\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "else:\n",
        "\n",
        "    event_summary = pd.DataFrame()\n",
        "\n",
        "    print(\n",
        "        \"No station-relative upper-tail dates \"\n",
        "        \"met the screening criteria.\"\n",
        "    )\n",
        "\n",
        "print(\"Station-relative anomaly screening completed.\")\n"
      ]
    },
