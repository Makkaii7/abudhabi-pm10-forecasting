        "\n",
        "# ============================================================\n",
        "# STEP 16 — CROSS-STATION SYNCHRONY\n",
        "# Do different stations experience similar pollutant movements?\n",
        "# ============================================================\n",
        "\n",
        "MIN_STATION_MONTH_DAYS = 3\n",
        "\n",
        "sync_base = master[\n",
        "    [\"station_id\", \"station\", \"day\"] + POLLUTANTS\n",
        "].copy()\n",
        "\n",
        "# Keep only daily measurements with sufficient support\n",
        "for p in POLLUTANTS:\n",
        "    sync_base[p] = sync_base[p].where(\n",
        "        master[f\"{p}_readings\"] >= MIN_READINGS\n",
        "    )\n",
        "\n",
        "sync_base[\"month\"] = (\n",
        "    sync_base[\"day\"].dt.to_period(\"M\").astype(str)\n",
        ")\n",
        "\n",
        "synchrony_rows = []\n",
        "synchrony_support_rows = []\n",
        "\n",
        "for p in POLLUTANTS:\n",
        "\n",
        "    temp = sync_base[\n",
        "        [\"station_id\", \"day\", \"month\", p]\n",
        "    ].dropna().copy()\n",
        "\n",
        "    # Log transformation requires non-negative measurements\n",
        "    temp = temp[temp[p] >= 0]\n",
        "\n",
        "    if temp.empty:\n",
        "        continue\n",
        "\n",
        "    temp[\"log_value\"] = np.log1p(temp[p])\n",
        "\n",
        "    # Count supported daily observations per station-month\n",
        "    temp[\"station_month_n\"] = (\n",
        "        temp.groupby([\"station_id\", \"month\"])[\"log_value\"]\n",
        "        .transform(\"size\")\n",
        "    )\n",
        "\n",
        "    groups_before = temp.groupby(\n",
        "        [\"station_id\", \"month\"]\n",
        "    ).ngroups\n",
        "\n",
        "    groups_retained = temp.loc[\n",
        "        temp[\"station_month_n\"] >= MIN_STATION_MONTH_DAYS,\n",
        "        [\"station_id\", \"month\"]\n",
        "    ].drop_duplicates().shape[0]\n",
        "\n",
        "    synchrony_support_rows.append({\n",
        "        \"pollutant\": p,\n",
        "        \"station_month_groups_before_filter\": groups_before,\n",
        "        \"station_month_groups_retained\": groups_retained,\n",
        "        \"supported_records_retained\": int(\n",
        "            (temp[\"station_month_n\"] >= MIN_STATION_MONTH_DAYS).sum()\n",
        "        )\n",
        "    })\n",
        "\n",
        "    # Exclude station-month groups with insufficient observations\n",
        "    temp = temp[\n",
        "        temp[\"station_month_n\"] >= MIN_STATION_MONTH_DAYS\n",
        "    ].copy()\n",
        "\n",
        "    if temp.empty:\n",
        "        continue\n",
        "\n",
        "    # Remove each station's monthly median level\n",
        "    temp[\"adjusted\"] = (\n",
        "        temp[\"log_value\"]\n",
        "        - temp.groupby(\n",
        "            [\"station_id\", \"month\"]\n",
        "        )[\"log_value\"].transform(\"median\")\n",
        "    )\n",
        "\n",
        "    # Align stations by date\n",
        "    wide = temp.pivot(\n",
        "        index=\"day\",\n",
        "        columns=\"station_id\",\n",
        "        values=\"adjusted\"\n",
        "    )\n",
        "\n",
        "    # Compare every available station pair\n",
        "    for a, b in combinations(wide.columns, 2):\n",
        "\n",
        "        pair = wide[[a, b]].dropna()\n",
        "\n",
        "        if (\n",
        "            len(pair) >= MIN_PAIR_DAYS\n",
        "            and pair[a].nunique() > 1\n",
        "            and pair[b].nunique() > 1\n",
        "        ):\n",
        "\n",
        "            synchrony_rows.append({\n",
        "                \"pollutant\": p,\n",
        "                \"station_id_1\": a,\n",
        "                \"station_id_2\": b,\n",
        "                \"overlapping_days\": len(pair),\n",
        "                \"spearman_rho\": pair[a].corr(\n",
        "                    pair[b], method=\"spearman\"\n",
        "                )\n",
        "            })\n",
        "\n",
        "synchrony_pairs = pd.DataFrame(\n",
        "    synchrony_rows,\n",
        "    columns=[\n",
        "        \"pollutant\",\n",
        "        \"station_id_1\",\n",
        "        \"station_id_2\",\n",
        "        \"overlapping_days\",\n",
        "        \"spearman_rho\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "synchrony_support = pd.DataFrame(synchrony_support_rows)\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# Summarize station-pair relationships\n",
        "# ------------------------------------------------------------\n",
        "if len(synchrony_pairs):\n",
        "\n",
        "    synchrony_summary = (\n",
        "        synchrony_pairs.groupby(\"pollutant\")\n",
        "        .agg(\n",
        "            station_pairs=(\"spearman_rho\", \"size\"),\n",
        "            median_pairwise_rho=(\"spearman_rho\", \"median\"),\n",
        "            q25_pairwise_rho=(\"spearman_rho\", lambda x: x.quantile(0.25)),\n",
        "            q75_pairwise_rho=(\"spearman_rho\", lambda x: x.quantile(0.75)),\n",
        "            positive_pair_share=(\"spearman_rho\", lambda x: (x > 0).mean()),\n",
        "            median_overlap_days=(\"overlapping_days\", \"median\")\n",
        "        )\n",
        "        .reindex(POLLUTANTS)\n",
        "        .reset_index()\n",
        "    )\n",
        "\n",
        "    display(synchrony_summary.round(3))\n",
        "    display(synchrony_support)\n",
        "\n",
        "    # --------------------------------------------------------\n",
        "    # Visualize correlation distributions across station pairs\n",
        "    # --------------------------------------------------------\n",
        "    groups = [\n",
        "        synchrony_pairs.loc[\n",
        "            synchrony_pairs.pollutant == p,\n",
        "            \"spearman_rho\"\n",
        "        ].values\n",
        "        for p in POLLUTANTS\n",
        "    ]\n",
        "\n",
        "    fig, ax = plt.subplots(figsize=(7.8, 4.2))\n",
        "\n",
        "    ax.boxplot(\n",
        "        groups,\n",
        "        tick_labels=POLLUTANTS,\n",
        "        showfliers=False,\n",
        "        patch_artist=True,\n",
        "        boxprops=dict(\n",
        "            facecolor=\"#9DB9D2\",\n",
        "            alpha=0.85\n",
        "        ),\n",
        "        medianprops=dict(\n",
        "            color=\"#9B3C32\",\n",
        "            linewidth=1.5\n",
        "        )\n",
        "    )\n",
        "\n",
        "    ax.axhline(0, color=\"black\", linewidth=0.8, alpha=0.6)\n",
        "\n",
        "    ax.set_ylabel(\"Pairwise station Spearman rho\")\n",
        "\n",
        "    ax.set_title(\n",
        "        f\"Cross-station synchrony after monthly adjustment\\n\"\n",
        "        f\"({MIN_STATION_MONTH_DAYS}+ supported days per station-month)\"\n",
        "    )\n",
        "\n",
        "    ax.grid(axis=\"y\", alpha=0.2)\n",
        "\n",
        "    fig.savefig(\n",
        "        FIGURES_DIR / \"09_cross_station_synchrony.png\",\n",
        "        bbox_inches=\"tight\"\n",
        "    )\n",
        "\n",
        "    plt.show()\n",
        "\n",
        "else:\n",
        "\n",
        "    synchrony_summary = pd.DataFrame(\n",
        "        columns=[\n",
        "            \"pollutant\", \"station_pairs\",\n",
        "            \"median_pairwise_rho\",\n",
        "            \"q25_pairwise_rho\",\n",
        "            \"q75_pairwise_rho\",\n",
        "            \"positive_pair_share\",\n",
        "            \"median_overlap_days\"\n",
        "        ]\n",
        "    )\n",
        "\n",
        "    print(\"No station pairs met the minimum overlap requirements.\")\n",
        "\n",
        "print(\"Cross-station synchrony analysis completed.\")\n"
      ]
    },
