      "source": [
        "# For each pollutant, use measurements with sufficient daily reading support.\n",
        "valid_corr = master[[\"station_id\", \"day\"] + POLLUTANTS].copy()\n",
        "for p in POLLUTANTS:\n",
        "    valid_corr[p] = valid_corr[p].where(master[f\"{p}_readings\"].ge(MIN_READINGS))\n",
        "\n",
        "# Within-station centring removes persistent station-level offsets.\n",
        "within_station = valid_corr[[\"station_id\"] + POLLUTANTS].copy()\n",
        "for p in POLLUTANTS:\n",
        "    within_station[p] = within_station[p] - within_station.groupby(\"station_id\")[p].transform(\"median\")\n",
        "\n",
        "spearman_within = within_station[POLLUTANTS].corr(method=\"spearman\", min_periods=30)\n",
        "pearson_within = within_station[POLLUTANTS].corr(method=\"pearson\", min_periods=30)\n",
        "raw_spearman = valid_corr[POLLUTANTS].corr(method=\"spearman\", min_periods=30)\n",
        "\n",
        "pair_count = pd.DataFrame(index=POLLUTANTS, columns=POLLUTANTS, dtype=int)\n",
        "for a in POLLUTANTS:\n",
        "    for b in POLLUTANTS:\n",
        "        pair_count.loc[a, b] = int(within_station[[a, b]].dropna().shape[0])\n",
        "\n",
        "print(\"Primary: within-station-centred Spearman correlations\")\n",
        "display(spearman_within.round(3))\n",
        "print(\"Pairwise observations behind each within-station correlation\")\n",
        "display(pair_count)\n",
        "print(\"Sensitivity: raw pooled Spearman correlations\")\n",
        "display(raw_spearman.round(3))\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(6.6, 5.2))\n",
        "mat = spearman_within.to_numpy(dtype=float)\n",
        "im = ax.imshow(mat, cmap=\"RdBu_r\", norm=TwoSlopeNorm(vmin=-1, vcenter=0, vmax=1))\n",
        "ax.set_xticks(range(len(POLLUTANTS)), POLLUTANTS)\n",
        "ax.set_yticks(range(len(POLLUTANTS)), POLLUTANTS)\n",
        "for i in range(len(POLLUTANTS)):\n",
        "    for j in range(len(POLLUTANTS)):\n",
        "        rho = mat[i, j]\n",
        "        n = int(pair_count.iloc[i, j])\n",
        "        label = f\"{rho:.2f}\\n(n={n})\" if np.isfinite(rho) else \"NA\"\n",
        "        ax.text(j, i, label, ha=\"center\", va=\"center\", fontsize=8,\n",
        "                color=\"white\" if np.isfinite(rho) and abs(rho) > .55 else \"black\")\n",
        "ax.set_title(\"Within-station Spearman association\\n(pairwise n shown in each cell)\")\n",
        "fig.colorbar(im, ax=ax, shrink=.78, label=\"Spearman rho\")\n",
        "fig.savefig(FIGURES_DIR / \"04_within_station_spearman.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
