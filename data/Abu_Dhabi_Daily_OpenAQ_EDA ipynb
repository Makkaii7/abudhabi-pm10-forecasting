        "    reporting_stations=(\"station_id\", \"nunique\"),\n",
        "    observed_dates=(\"day\", \"nunique\"),\n",
        ").reset_index()\n",
        "monthly_support[\"share_12plus_pct\"] = 100 * monthly_support[\"share_12plus\"]\n",
        "display(monthly_support.round(2))\n",
        "\n",
        "fig, axes = plt.subplots(2, 1, figsize=(10, 5.2), sharex=True)\n",
        "axes[0].plot(monthly_support[\"month_start\"], monthly_support[\"median_readings\"], marker=\"o\", ms=3, lw=1.6, color=\"#4472A8\")\n",
        "axes[0].axhline(MIN_READINGS, color=\"#C45148\", ls=\"--\", lw=1, label=f\"{MIN_READINGS}-reading review threshold\")\n",
        "axes[0].set_ylabel(\"Median readings\")\n",
        "axes[0].set_title(\"Monthly measurement support\")\n",
        "axes[0].legend(frameon=False, loc=\"upper left\")\n",
        "axes[0].grid(alpha=.2)\n",
        "axes[1].plot(monthly_support[\"month_start\"], monthly_support[\"share_12plus_pct\"], marker=\"o\", ms=3, lw=1.6, color=\"#4C9A79\")\n",
        "axes[1].set_ylabel(\"Records with 12+ readings (%)\")\n",
        "axes[1].set_ylim(-3, 103)\n",
        "axes[1].set_xlabel(\"Month\")\n",
        "axes[1].grid(alpha=.2)\n",
        "fig.suptitle(\"Sampling support changes across the study period\", fontsize=12, fontweight=\"bold\")\n",
