      "source": [
        "COLAB_DIR = Path(\"/content\")\n",
        "\n",
        "def locate_csv(keyword):\n",
        "    matches = [\n",
        "        Path(p) for p in glob.glob(str(COLAB_DIR / \"*.csv\"))\n",
        "        if keyword.lower() in Path(p).name.lower()\n",
        "    ]\n",
        "    if not matches:\n",
        "        available = sorted(Path(p).name for p in glob.glob(str(COLAB_DIR / \"*.csv\")))\n",
        "        raise FileNotFoundError(\n",
        "            f\"Could not find '{keyword}'. CSV files currently in /content: {available}. \"\n",
        "            \"Upload the required file directly into this Colab session.\"\n",
        "        )\n",
        "    matches.sort(key=lambda p: p.stat().st_mtime, reverse=True)\n",
        "    return matches[0]\n",
        "\n",
        "DAILY_FILE = locate_csv(\"openaq_daily_all_stations\")\n",
        "STATIONS_FILE = locate_csv(\"openaq_stations\")\n",
        "\n",
        "print(\"Daily observations:\", DAILY_FILE.name)\n",
        "print(\"Station metadata:\", STATIONS_FILE.name)"
      ]
