        "\n",
        "# ============================================================\n",
        "# STEP 13 — MONTHLY POLLUTANT BEHAVIOUR\n",
        "# Primary analysis: daily records with at least 12 readings.\n",
        "# Sensitivity analysis: all available daily records.\n",
        "# ============================================================\n",
        "\n",
        "master[\"month_start\"] = (\n",
        "    master[\"day\"].dt.to_period(\"M\").dt.to_timestamp()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 1. Calculate monthly station medians using ALL observations\n",
        "# ------------------------------------------------------------\n",
        "monthly_all_station = (\n",
        "    master.groupby(\n",
        "        [\"month_start\", \"station_id\", \"station\"]\n",
        "    )[POLLUTANTS]\n",
        "    .median()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "monthly_all_network = (\n",
        "    monthly_all_station.groupby(\"month_start\")[POLLUTANTS]\n",
        "    .median()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 2. Prepare the primary dataset: 12+ readings only\n",
        "# ------------------------------------------------------------\n",
        "monthly_supported = master[\n",
        "    [\"month_start\", \"station_id\", \"station\"] + POLLUTANTS\n",
        "].copy()\n",
        "\n",
        "for p in POLLUTANTS:\n",
        "    monthly_supported[p] = monthly_supported[p].where(\n",
        "        master[f\"{p}_readings\"] >= MIN_READINGS\n",
        "    )\n",
        "\n",
        "# Monthly median within each station\n",
        "monthly_station = (\n",
        "    monthly_supported.groupby(\n",
        "        [\"month_start\", \"station_id\", \"station\"]\n",
        "    )[POLLUTANTS]\n",
        "    .median()\n",
        "    .reset_index()\n",
        ")\n",
        "\n",
        "# Median across contributing stations\n",
        "monthly_network = (\n",
        "    monthly_station.groupby(\"month_start\")[POLLUTANTS]\n",
        "    .median()\n",
        ")\n",
        "\n",
        "# Number of stations contributing to each pollutant/month\n",
        "monthly_station_n = (\n",
        "    monthly_station.groupby(\"month_start\")[POLLUTANTS]\n",
        "    .count()\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 3. Compare supported and unrestricted monthly trends\n",
        "# ------------------------------------------------------------\n",
        "monthly_sensitivity = pd.concat(\n",
        "    {\n",
        "        \"supported_12plus\": monthly_network,\n",
        "        \"all_available\": monthly_all_network\n",
        "    },\n",
        "    names=[\"support_rule\", \"month_start\"]\n",
        ").reset_index()\n",
        "\n",
        "display(monthly_sensitivity.head(10))\n",
        "\n",
        "monthly_sensitivity.to_csv(\n",
        "    OUTPUT_DIR / \"monthly_trend_support_sensitivity.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "# ------------------------------------------------------------\n",
        "# 4. Visualize the results\n",
        "# ------------------------------------------------------------\n",
        "fig, axes = plt.subplots(\n",
        "    3, 2,\n",
        "    figsize=(10, 6.4),\n",
        "    sharex=True\n",
        ")\n",
        "\n",
        "axes = axes.ravel()\n",
        "\n",
        "for ax, p in zip(axes[:5], POLLUTANTS):\n",
        "\n",
        "    ax.plot(\n",
        "        monthly_network.index,\n",
        "        monthly_network[p],\n",
        "        color=\"#4472A8\",\n",
        "        linewidth=1.6,\n",
        "        marker=\"o\",\n",
        "        markersize=2.6,\n",
        "        label=\"12+ readings (primary)\"\n",
        "    )\n",
        "\n",
        "    ax.plot(\n",
        "        monthly_all_network.index,\n",
        "        monthly_all_network[p],\n",
        "        color=\"#D69A36\",\n",
        "        linewidth=1.1,\n",
        "        linestyle=\"--\",\n",
        "        alpha=0.8,\n",
        "        label=\"All observations (sensitivity)\"\n",
        "    )\n",
        "\n",
        "    ax.set_title(p)\n",
        "    ax.set_ylabel(\"Median of station medians\")\n",
        "    ax.grid(alpha=0.2)\n",
        "\n",
        "axes[0].legend(frameon=False, fontsize=7)\n",
        "\n",
        "# Reporting stations under the primary quality rule\n",
        "for p in POLLUTANTS:\n",
        "    axes[5].plot(\n",
        "        monthly_station_n.index,\n",
        "        monthly_station_n[p],\n",
        "        marker=\".\",\n",
        "        markersize=2.5,\n",
        "        linewidth=1.1,\n",
        "        label=p\n",
        "    )\n",
        "\n",
        "axes[5].set_title(\"Stations contributing (12+ readings)\")\n",
        "axes[5].set_ylabel(\"Number of stations\")\n",
        "axes[5].legend(frameon=False, fontsize=6, ncol=2)\n",
        "axes[5].grid(alpha=0.2)\n",
        "\n",
        "for ax in axes[4:]:\n",
        "    ax.tick_params(axis=\"x\", rotation=25)\n",
        "\n",
        "fig.suptitle(\n",
        "    \"Monthly pollutant patterns: supported data and coverage\",\n",
        "    fontsize=12,\n",
        "    fontweight=\"bold\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "fig.savefig(\n",
        "    FIGURES_DIR / \"06_monthly_patterns_and_coverage.png\",\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "plt.show()\n",
        "\n",
        "print(\"Monthly trend analysis completed.\")\n"
      ]
    },
