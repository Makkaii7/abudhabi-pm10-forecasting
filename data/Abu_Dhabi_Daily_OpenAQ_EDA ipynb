      "source": [
        "required_daily = {\"station_id\", \"station\", \"parameter\", \"day\", \"readings\", \"mean\", \"max\"}\n",
        "required_stations = {\"station_id\", \"station\", \"lat\", \"lon\"}\n",
        "\n",
        "# Standardize column names first.\n",
        "daily = daily_raw.copy()\n",
        "stations = stations_raw.copy()\n",
        "daily.columns = daily.columns.str.strip().str.lower()\n",
        "stations.columns = stations.columns.str.strip().str.lower()\n",
        "\n",
        "missing_daily = required_daily - set(daily.columns)\n",
        "missing_stations = required_stations - set(stations.columns)\n",
        "if missing_daily:\n",
        "    raise ValueError(f\"Daily file is missing columns: {sorted(missing_daily)}\")\n",
        "if missing_stations:\n",
        "    raise ValueError(f\"Station file is missing columns: {sorted(missing_stations)}\")\n",
        "\n",
        "daily[\"station_id\"] = pd.to_numeric(daily[\"station_id\"], errors=\"coerce\")\n",
        "daily[\"station\"] = daily[\"station\"].astype(\"string\").str.strip()\n",
        "daily[\"parameter\"] = daily[\"parameter\"].astype(\"string\").str.strip().str.upper()\n",
        "daily[\"day\"] = pd.to_datetime(daily[\"day\"], errors=\"coerce\").dt.normalize()\n",
        "for c in [\"readings\", \"mean\", \"max\"]:\n",
        "    daily[c] = pd.to_numeric(daily[c], errors=\"coerce\")\n",
        "\n",
        "stations[\"station_id\"] = pd.to_numeric(stations[\"station_id\"], errors=\"coerce\")\n",
        "stations[\"station\"] = stations[\"station\"].astype(\"string\").str.strip()\n",
        "stations[\"lat\"] = pd.to_numeric(stations[\"lat\"], errors=\"coerce\")\n",
        "stations[\"lon\"] = pd.to_numeric(stations[\"lon\"], errors=\"coerce\")\n",
        "\n",
        "unexpected_parameters = sorted(set(daily[\"parameter\"].dropna().unique()) - set(POLLUTANTS))\n",
        "invalid_date_rows = int(daily[\"day\"].isna().sum())\n",
        "invalid_station_rows = int(daily[\"station_id\"].isna().sum())\n",
        "\n",
        "daily = daily[daily[\"parameter\"].isin(POLLUTANTS)].copy()\n",
        "daily = daily.dropna(subset=[\"station_id\", \"station\", \"day\"]).copy()\n",
        "daily[\"station_id\"] = daily[\"station_id\"].astype(\"int64\")\n",
        "stations = stations.dropna(subset=[\"station_id\"]).copy()\n",
        "stations[\"station_id\"] = stations[\"station_id\"].astype(\"int64\")\n",
        "\n",
